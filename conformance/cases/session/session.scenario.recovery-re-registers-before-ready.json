{
  "schemaVersion": 1,
  "id": "session.scenario.recovery-re-registers-before-ready",
  "specRefs": [
    "session.lifecycle",
    "session.report-routing"
  ],
  "description": "After a failed ping the session is degraded; the next successful ping re-registers the keys on a new socket, reports their values, and only then is the session ready.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "call": "register",
        "keys": [
          {
            "type": "variable",
            "name": "x_a"
          },
          {
            "type": "attribute",
            "objectName": "DOU1001",
            "index": "0"
          }
        ],
        "as": "reg"
      },
      {
        "expectSent": {
          "socket": "@first",
          "msgId": "$m1",
          "payload": "SYSTEM:clientRegister(0,0,1,{\"x_a\",{DOU1001,0}})"
        }
      },
      {
        "respond": {
          "socket": "@first",
          "msgId": "$m1",
          "payload": "clientReport:1:{1,\"ON\"}"
        }
      },
      {
        "await": "reg",
        "result": {
          "slots": [
            {
              "type": "int",
              "value": "1"
            },
            {
              "type": "string",
              "value": "ON"
            }
          ]
        }
      },
      {
        "call": "ping",
        "as": "lost"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "advance": 5000
      },
      {
        "await": "lost",
        "result": {
          "ok": false
        }
      },
      {
        "expectState": "degraded"
      },
      {
        "call": "ping",
        "as": "back"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "expectSent": {
          "socket": "@again",
          "msgId": "$m2",
          "payload": "SYSTEM:clientRegister(0,0,1,{\"x_a\",{DOU1001,0}})"
        }
      },
      {
        "expectState": "degraded"
      },
      {
        "respond": {
          "socket": "@again",
          "msgId": "$m2",
          "payload": "clientReport:1:{0,\"OFF\"}"
        }
      },
      {
        "expectReport": {
          "keys": [
            {
              "type": "variable",
              "name": "x_a"
            },
            {
              "type": "attribute",
              "objectName": "DOU1001",
              "index": "0"
            }
          ],
          "values": [
            {
              "type": "int",
              "value": "0"
            },
            {
              "type": "string",
              "value": "OFF"
            }
          ]
        }
      },
      {
        "await": "back",
        "result": {
          "ok": true
        }
      },
      {
        "expectState": "ready"
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
