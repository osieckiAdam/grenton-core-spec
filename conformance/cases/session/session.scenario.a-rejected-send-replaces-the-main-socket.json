{
  "schemaVersion": 1,
  "id": "session.scenario.a-rejected-send-replaces-the-main-socket",
  "specRefs": [
    "session.lifecycle",
    "session.correlation"
  ],
  "description": "A ping whose send the transport rejects fails at once and closes the main socket, without waiting for a timeout; actions are not connected, and the next ping opens a new socket and recovers.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "failSend": "@main"
      },
      {
        "call": "ping",
        "as": "rejected"
      },
      {
        "await": "rejected",
        "result": {
          "ok": false
        }
      },
      {
        "expectClosed": "@main"
      },
      {
        "expectState": "degraded"
      },
      {
        "call": "execute",
        "action": {
          "event": "ON",
          "cluId": "CLU_1",
          "objectName": "DOU1001",
          "index": "0",
          "value": "1",
          "callType": "ATTRIBUTE"
        },
        "as": "meanwhile"
      },
      {
        "await": "meanwhile",
        "result": {
          "error": "session.notConnected"
        }
      },
      {
        "call": "ping",
        "as": "again"
      },
      {
        "expectSent": {
          "socket": "@main2",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main2",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "again",
        "result": {
          "ok": true
        }
      },
      {
        "expectState": "ready"
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
