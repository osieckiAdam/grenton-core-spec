{
  "schemaVersion": 1,
  "id": "session.scenario.start-pings-and-becomes-ready",
  "specRefs": [
    "session.lifecycle",
    "session.keepalive"
  ],
  "description": "start() opens the main socket and sends checkAlive(); any reply with the matching msg_id makes the session ready.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "expectState": "idle"
      },
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "expectState": "starting"
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "anything"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
