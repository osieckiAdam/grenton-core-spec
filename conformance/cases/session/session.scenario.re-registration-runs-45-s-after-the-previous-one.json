{
  "schemaVersion": 1,
  "id": "session.scenario.re-registration-runs-45-s-after-the-previous-one",
  "specRefs": [
    "session.chunking",
    "session.loops",
    "session.report-routing"
  ],
  "description": "45 s after a registration ends the session registers the same keys again on a new socket, closes the old one, and reports the fresh values.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "call": "register",
        "keys": [
          {
            "type": "variable",
            "name": "x_a"
          },
          {
            "type": "attribute",
            "objectName": "DOU1001",
            "index": "0"
          }
        ],
        "as": "reg"
      },
      {
        "expectSent": {
          "socket": "@first",
          "msgId": "$m1",
          "payload": "SYSTEM:clientRegister(0,0,1,{\"x_a\",{DOU1001,0}})"
        }
      },
      {
        "advance": 3000
      },
      {
        "respond": {
          "socket": "@first",
          "msgId": "$m1",
          "payload": "clientReport:1:{1,\"ON\"}"
        }
      },
      {
        "await": "reg",
        "result": {
          "slots": [
            {
              "type": "int",
              "value": "1"
            },
            {
              "type": "string",
              "value": "ON"
            }
          ]
        }
      },
      {
        "advance": 44999
      },
      {
        "expectQuiet": true
      },
      {
        "advance": 1
      },
      {
        "expectSent": {
          "socket": "@second",
          "msgId": "$m2",
          "payload": "SYSTEM:clientRegister(0,0,1,{\"x_a\",{DOU1001,0}})"
        }
      },
      {
        "expectClosed": "@first"
      },
      {
        "respond": {
          "socket": "@second",
          "msgId": "$m2",
          "payload": "clientReport:1:{0,\"OFF\"}"
        }
      },
      {
        "expectReport": {
          "keys": [
            {
              "type": "variable",
              "name": "x_a"
            },
            {
              "type": "attribute",
              "objectName": "DOU1001",
              "index": "0"
            }
          ],
          "values": [
            {
              "type": "int",
              "value": "0"
            },
            {
              "type": "string",
              "value": "OFF"
            }
          ]
        }
      },
      {
        "advance": 45000
      },
      {
        "expectSent": {
          "socket": "@third",
          "msgId": "$m3",
          "payload": "SYSTEM:clientRegister(0,0,1,{\"x_a\",{DOU1001,0}})"
        }
      },
      {
        "respond": {
          "socket": "@third",
          "msgId": "$m3",
          "payload": "clientReport:1:{0,\"OFF\"}"
        }
      },
      {
        "expectReport": {
          "keys": [
            {
              "type": "variable",
              "name": "x_a"
            },
            {
              "type": "attribute",
              "objectName": "DOU1001",
              "index": "0"
            }
          ],
          "values": [
            {
              "type": "int",
              "value": "0"
            },
            {
              "type": "string",
              "value": "OFF"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
