{
  "schemaVersion": 1,
  "id": "session.scenario.a-notification-for-a-replaced-number-is-dropped",
  "specRefs": [
    "session.chunking",
    "session.report-routing"
  ],
  "description": "After a key list was replaced under a new session number, a late notification carrying the old number is dropped, one with the new number is reported.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "call": "register",
        "keys": [
          {
            "type": "attribute",
            "objectName": "OBJ",
            "index": "0"
          }
        ],
        "as": "r1"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$m1",
          "payload": "SYSTEM:clientRegister(0,0,1,{{OBJ,0}})"
        }
      },
      {
        "call": "register",
        "keys": [
          {
            "type": "attribute",
            "objectName": "OBJ",
            "index": "1"
          }
        ],
        "as": "r2"
      },
      {
        "expectQuiet": true
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$m1",
          "payload": "clientReport:1:{5}"
        }
      },
      {
        "await": "r1",
        "result": {
          "slots": [
            {
              "type": "int",
              "value": "5"
            }
          ]
        }
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$m2",
          "payload": "SYSTEM:clientRegister(0,0,2,{{OBJ,1}})"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$m2",
          "payload": "clientReport:2:{6}"
        }
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$d1",
          "payload": "SYSTEM:clientDestroy(0,0,1)"
        }
      },
      {
        "await": "r2",
        "result": {
          "slots": [
            {
              "type": "int",
              "value": "6"
            }
          ]
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "00000000",
          "payload": "clientReport:1:{42}"
        }
      },
      {
        "expectNoReport": true
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "00000000",
          "payload": "clientReport:2:{7}"
        }
      },
      {
        "expectReport": {
          "keys": [
            {
              "type": "attribute",
              "objectName": "OBJ",
              "index": "1"
            }
          ],
          "values": [
            {
              "type": "int",
              "value": "7"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
