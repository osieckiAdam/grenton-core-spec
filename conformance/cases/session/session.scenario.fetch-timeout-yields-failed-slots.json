{
  "schemaVersion": 1,
  "id": "session.scenario.fetch-timeout-yields-failed-slots",
  "specRefs": [
    "session.fetch",
    "session.correlation"
  ],
  "description": "A fetch that gets no reply within the response timeout yields failed slots; a client report in place of a values: reply fails it too.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "call": "fetch",
        "keys": [
          {
            "type": "variable",
            "name": "x_a"
          },
          {
            "type": "attribute",
            "objectName": "DOU1001",
            "index": "0"
          }
        ],
        "as": "f1"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$m1",
          "payload": "SYSTEM:fetchValues({\"x_a\",{DOU1001,0}})"
        }
      },
      {
        "advance": 5000
      },
      {
        "await": "f1",
        "result": {
          "slots": [
            {
              "failed": true
            },
            {
              "failed": true
            }
          ]
        }
      },
      {
        "call": "fetch",
        "keys": [
          {
            "type": "variable",
            "name": "x_a"
          },
          {
            "type": "attribute",
            "objectName": "DOU1001",
            "index": "0"
          }
        ],
        "as": "f2"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$m2",
          "payload": "SYSTEM:fetchValues({\"x_a\",{DOU1001,0}})"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$m2",
          "payload": "clientReport:1:{1,\"ON\"}"
        }
      },
      {
        "await": "f2",
        "result": {
          "slots": [
            {
              "failed": true
            },
            {
              "failed": true
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
