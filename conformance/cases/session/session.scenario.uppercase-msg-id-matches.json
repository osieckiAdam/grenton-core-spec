{
  "schemaVersion": 1,
  "id": "session.scenario.uppercase-msg-id-matches",
  "specRefs": [
    "session.correlation"
  ],
  "description": "msg_id is compared in lowercase (§5.2): a reply with the id in capitals answers the request.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1",
          "upper": true
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
