{
  "schemaVersion": 1,
  "id": "session.scenario.register-waits-for-start",
  "specRefs": [
    "session.lifecycle"
  ],
  "description": "start and register are serialized: a registration requested while the initial ping is in flight is sent only after start() ends.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "call": "register",
        "keys": [
          {
            "type": "variable",
            "name": "x_a"
          },
          {
            "type": "attribute",
            "objectName": "DOU1001",
            "index": "0"
          }
        ],
        "as": "reg"
      },
      {
        "expectQuiet": true
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectSent": {
          "socket": "@chunk",
          "msgId": "$m",
          "payload": "SYSTEM:clientRegister(0,0,1,{\"x_a\",{DOU1001,0}})"
        }
      },
      {
        "respond": {
          "socket": "@chunk",
          "msgId": "$m",
          "payload": "clientReport:1:{1,\"ON\"}"
        }
      },
      {
        "await": "reg",
        "result": {
          "slots": [
            {
              "type": "int",
              "value": "1"
            },
            {
              "type": "string",
              "value": "ON"
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
