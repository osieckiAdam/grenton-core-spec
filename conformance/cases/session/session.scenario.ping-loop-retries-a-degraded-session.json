{
  "schemaVersion": 1,
  "id": "session.scenario.ping-loop-retries-a-degraded-session",
  "specRefs": [
    "session.lifecycle",
    "session.loops"
  ],
  "description": "When the first ping times out the session is degraded; the ping loop retries 5 s later and a reply makes the session ready.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "advance": 5000
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "degraded"
      },
      {
        "advance": 4999
      },
      {
        "expectQuiet": true
      },
      {
        "advance": 1
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "expectState": "ready"
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
