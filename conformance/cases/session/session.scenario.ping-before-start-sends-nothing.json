{
  "schemaVersion": 1,
  "id": "session.scenario.ping-before-start-sends-nothing",
  "specRefs": [
    "session.lifecycle",
    "session.keepalive"
  ],
  "description": "ping() on an idle session, and on a stopped one, sends nothing, fails, and leaves the state alone.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "expectState": "idle"
      },
      {
        "call": "ping",
        "as": "p1"
      },
      {
        "expectQuiet": true
      },
      {
        "await": "p1",
        "result": {
          "ok": false
        }
      },
      {
        "expectState": "idle"
      },
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "call": "stop",
        "as": "stop"
      },
      {
        "await": "stop",
        "result": null
      },
      {
        "expectClosed": "@main"
      },
      {
        "call": "ping",
        "as": "p2"
      },
      {
        "expectQuiet": true
      },
      {
        "await": "p2",
        "result": {
          "ok": false
        }
      },
      {
        "expectState": "stopped"
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
