{
  "schemaVersion": 1,
  "id": "session.scenario.stop-closes-sockets-and-ends-pending-requests",
  "specRefs": [
    "session.lifecycle"
  ],
  "description": "stop() closes the main socket, ends pending requests with connectionClosed, and later actions are not connected.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "call": "execute",
        "action": {
          "event": "ON",
          "cluId": "CLU_1",
          "objectName": "DOU1001",
          "index": "0",
          "value": "1",
          "callType": "ATTRIBUTE"
        },
        "as": "act"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$a",
          "payload": "DOU1001:set(0,\"1\")"
        }
      },
      {
        "call": "stop",
        "as": "stop"
      },
      {
        "await": "stop",
        "result": null
      },
      {
        "await": "act",
        "result": {
          "error": "session.connectionClosed"
        }
      },
      {
        "expectState": "stopped"
      },
      {
        "expectClosed": "@main"
      },
      {
        "call": "execute",
        "action": {
          "event": "ON",
          "cluId": "CLU_1",
          "objectName": "DOU1001",
          "index": "0",
          "value": "1",
          "callType": "ATTRIBUTE"
        },
        "as": "after"
      },
      {
        "await": "after",
        "result": {
          "error": "session.notConnected"
        }
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
