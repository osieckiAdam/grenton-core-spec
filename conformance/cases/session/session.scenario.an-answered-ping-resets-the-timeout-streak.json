{
  "schemaVersion": 1,
  "id": "session.scenario.an-answered-ping-resets-the-timeout-streak",
  "specRefs": [
    "session.lifecycle",
    "session.keepalive"
  ],
  "description": "Two unanswered pings, an answered one, two more unanswered: the main socket stays, because the answer reset the count. The third unanswered ping in a row closes it.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "call": "ping",
        "as": "t1"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "advance": 5000
      },
      {
        "await": "t1",
        "result": {
          "ok": false
        }
      },
      {
        "call": "ping",
        "as": "t2"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "advance": 5000
      },
      {
        "await": "t2",
        "result": {
          "ok": false
        }
      },
      {
        "call": "ping",
        "as": "ok"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "ok",
        "result": {
          "ok": true
        }
      },
      {
        "call": "ping",
        "as": "t3"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "advance": 5000
      },
      {
        "await": "t3",
        "result": {
          "ok": false
        }
      },
      {
        "call": "ping",
        "as": "t4"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "advance": 5000
      },
      {
        "await": "t4",
        "result": {
          "ok": false
        }
      },
      {
        "expectState": "degraded"
      },
      {
        "call": "ping",
        "as": "t5"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "advance": 5000
      },
      {
        "await": "t5",
        "result": {
          "ok": false
        }
      },
      {
        "expectClosed": "@main"
      },
      {
        "call": "ping",
        "as": "again"
      },
      {
        "expectSent": {
          "socket": "@main2",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main2",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "again",
        "result": {
          "ok": true
        }
      },
      {
        "expectState": "ready"
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
