{
  "schemaVersion": 1,
  "id": "session.scenario.stop-during-fetch-fails-the-rest",
  "specRefs": [
    "session.fetch",
    "session.lifecycle"
  ],
  "description": "stop() while the first fetch chunk awaits its reply ends that request and sends no further chunk: every slot is failed, nothing is destroyed (nothing was registered), the socket closes.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "registerFrameLimitBytes": 50,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "call": "fetch",
        "keys": [
          {
            "type": "variable",
            "name": "x_a"
          },
          {
            "type": "attribute",
            "objectName": "DOU1001",
            "index": "0"
          }
        ],
        "as": "f"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$m1",
          "payload": "SYSTEM:fetchValues({\"x_a\"})"
        }
      },
      {
        "call": "stop",
        "as": "stop"
      },
      {
        "await": "stop",
        "result": null
      },
      {
        "await": "f",
        "result": {
          "slots": [
            {
              "failed": true
            },
            {
              "failed": true
            }
          ]
        }
      },
      {
        "expectQuiet": true
      },
      {
        "expectClosed": "@main"
      },
      {
        "expectState": "stopped"
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
