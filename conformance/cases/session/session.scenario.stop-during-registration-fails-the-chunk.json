{
  "schemaVersion": 1,
  "id": "session.scenario.stop-during-registration-fails-the-chunk",
  "specRefs": [
    "session.lifecycle",
    "session.chunking"
  ],
  "description": "stop() while a chunk awaits its reply ends that request, so the chunk contributes failed slots; the chunk is still destroyed, because the CLU may have accepted it.",
  "provenance": "spec §5.3–§5.4 text, conformance.md §4b",
  "operation": "session.scenario",
  "input": {
    "clu": {
      "id": "CLU_1",
      "ip": "10.0.0.1",
      "port": 1234
    },
    "responseTimeoutMs": 5000,
    "pingIntervalMs": 3600000,
    "registerIntervalMs": 3600000,
    "steps": [
      {
        "call": "start",
        "as": "start"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "checkAlive()"
        }
      },
      {
        "respond": {
          "socket": "@main",
          "msgId": "$ka",
          "payload": "1"
        }
      },
      {
        "await": "start",
        "result": null
      },
      {
        "expectState": "ready"
      },
      {
        "call": "register",
        "keys": [
          {
            "type": "variable",
            "name": "x_a"
          },
          {
            "type": "attribute",
            "objectName": "DOU1001",
            "index": "0"
          }
        ],
        "as": "reg"
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$m",
          "payload": "SYSTEM:clientRegister(0,0,1,{\"x_a\",{DOU1001,0}})"
        }
      },
      {
        "call": "stop",
        "as": "stop"
      },
      {
        "await": "stop",
        "result": null
      },
      {
        "await": "reg",
        "result": {
          "slots": [
            {
              "failed": true
            },
            {
              "failed": true
            }
          ]
        }
      },
      {
        "expectSent": {
          "socket": "@main",
          "msgId": "$d",
          "payload": "SYSTEM:clientDestroy(0,0,1)"
        }
      },
      {
        "expectClosed": "@main"
      },
      {
        "expectState": "stopped"
      }
    ]
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "completed": true
    }
  }
}
