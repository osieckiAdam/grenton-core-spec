{
  "schemaVersion": 1,
  "id": "schedule.rules.whitespace",
  "specRefs": [
    "devices.schedule"
  ],
  "description": "Whitespace after the opening brace, around rows and inside a row does not change the reading.",
  "provenance": "spec §6.3.13",
  "operation": "schedule.rules",
  "input": {
    "text": "{ {2, 1, \"0 20 * * *\"} ,\n { 1 , 0 , \"0 23 * * 6,0\" } }"
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "rules": [
        {
          "id": 2,
          "isEnabled": true,
          "cron": "0 20 * * *",
          "hour": 20,
          "minute": 0,
          "days": [
            0,
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        {
          "id": 1,
          "isEnabled": false,
          "cron": "0 23 * * 6,0",
          "hour": 23,
          "minute": 0,
          "days": [
            0,
            6
          ]
        }
      ]
    }
  }
}
