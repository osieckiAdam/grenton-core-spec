{
  "schemaVersion": 1,
  "id": "schedule.rules.list",
  "specRefs": [
    "devices.schedule"
  ],
  "description": "A rule list in the CLU's order (not by id): the weekday list of the app, a range from the Object Manager manual, 7 read as Sunday, every day as *, and a disabled rule.",
  "provenance": "spec §6.3.13",
  "operation": "schedule.rules",
  "input": {
    "text": "{{2, 1, \"0 20 * * *\"},{4, 1, \"25 22 * * 1,2,3\"},{3, 0, \"15 8 * * 1-5\"},{1, 1, \"0 23 * * 6,7\"}}"
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "rules": [
        {
          "id": 2,
          "isEnabled": true,
          "cron": "0 20 * * *",
          "hour": 20,
          "minute": 0,
          "days": [
            0,
            1,
            2,
            3,
            4,
            5,
            6
          ]
        },
        {
          "id": 4,
          "isEnabled": true,
          "cron": "25 22 * * 1,2,3",
          "hour": 22,
          "minute": 25,
          "days": [
            1,
            2,
            3
          ]
        },
        {
          "id": 3,
          "isEnabled": false,
          "cron": "15 8 * * 1-5",
          "hour": 8,
          "minute": 15,
          "days": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        {
          "id": 1,
          "isEnabled": true,
          "cron": "0 23 * * 6,7",
          "hour": 23,
          "minute": 0,
          "days": [
            0,
            6
          ]
        }
      ]
    }
  }
}
