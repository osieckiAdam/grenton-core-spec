{
  "schemaVersion": 1,
  "id": "crypto.encrypt.error-key-not-base64",
  "specRefs": [
    "crypto.key-material"
  ],
  "description": "Key material must be valid base64.",
  "provenance": "spec §5.1",
  "operation": "crypto.encrypt",
  "input": {
    "keyBase64": "not base64!",
    "ivBase64": "EBESExQVFhcYGRobHB0eHw==",
    "plaintextHex": "78"
  },
  "expect": {
    "outcome": "error",
    "code": "crypto.invalidKeyMaterial"
  }
}
