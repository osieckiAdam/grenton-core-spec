{
  "schemaVersion": 1,
  "id": "payload.report.empty-element",
  "specRefs": [
    "payload.report"
  ],
  "description": "An empty element is the empty string.",
  "provenance": "spec §5.3.2",
  "operation": "payload.report",
  "input": {
    "payload": "clientReport:1:{1,,2}"
  },
  "expect": {
    "outcome": "ok",
    "value": {
      "sessionId": 1,
      "values": [
        {
          "type": "int",
          "value": "1"
        },
        {
          "type": "string",
          "value": ""
        },
        {
          "type": "int",
          "value": "2"
        }
      ]
    }
  }
}
