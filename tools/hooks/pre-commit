#!/bin/sh
# Gates on every commit. Install once: git config core.hooksPath tools/hooks
set -e
cd "$(git rev-parse --show-toplevel)"
python3 tools/check_no_installation_data.py --staged
python3 tools/check_versions.py --staged
if ! out=$(python3 tools/suite.py check); then echo "$out"; exit 1; fi
echo "$out" | tail -1
