#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"
python3 tools/check_no_installation_data.py --all
python3 tools/check_versions.py
python3 tools/suite.py check
cat <<'NOTE'

Spec pushed? Every port must follow: in grenton-core-swift, move the
submodule (git -C vendor/grenton-core-spec fetch && git -C vendor/grenton-core-spec checkout origin/main),
bump port.json when the suite version changed, and run scripts/check.sh.
NOTE
